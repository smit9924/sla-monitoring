# Environment variables this cloud function needs at runtime.
# When deploying, set these with `gcloud functions deploy --set-env-vars` (or
# the equivalent in your deployment tool) — a cloud function has no .env file
# of its own, unlike the monitoring API.
#
# These must point at the same Postgres database the monitoring API uses,
# since both read/write the same uploaded_files and service_logs tables.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sla_monitoring
POSTGRES_USER=sla_admin
POSTGRES_PASSWORD=sla_admin_password
