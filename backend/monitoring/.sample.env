# Runtime
# Local: ENVIRONMENT=local, LOG_FORMAT=console (daily files under bin/logs/)
# Production server: ENVIRONMENT=production, LOG_FORMAT=json (stdout only)
ENVIRONMENT=local
SERVICE_NAME=monitoring
# 👇 DEBUG → INFO → WARNING → ERROR → CRITICAL
LOG_LEVEL=INFO
# 👇 json/console
LOG_FORMAT=console
LOG_RETENTION_DAYS=10

# CORS
ALLOWED_ORIGINS=["http://localhost:4200"]
ALLOWED_CREDENTIALS=True
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# Storage
# 👇 gcs (only provider currently implemented)
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=your-bucket-name
# Optional: path to a service-account JSON key file. Leave unset to use
# Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.
GCS_CREDENTIALS_PATH=
GCS_SIGNED_URL_EXPIRATION_SECONDS=3600

# Database configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sla_monitoring
POSTGRES_USER=sla_admin
POSTGRES_PASSWORD=sla_admin_password
