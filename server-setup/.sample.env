# =============================================================================
# PostgreSQL
# =============================================================================
# Reachable directly (no Nginx proxy) at db.slamonitoring.hospitia.in:5432
POSTGRES_USER=sla_admin
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_DB=sla_monitoring

# =============================================================================
# Docker container log rotation (json-file driver)
# =============================================================================
# Applied to every service in docker-compose.yml, so container logs on the
# server do not grow without bound.
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=3
